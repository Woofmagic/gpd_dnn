Cell[CellGroupData[{

Cell["(#X): Testing Strange Mathematica Behavior:", "Chapter",
 CellChangeTimes->{{3.973334204034767*^9, 
  3.973334214336443*^9}},ExpressionUUID->"6f3b5d82-d6b5-4de9-95f0-\
5efe9ea187d2"],

Cell[CellGroupData[{

Cell["\<\
(#X.1): Why Does Mathematica Not Simplify Re[(-\[ImaginaryI] Im\
\[ScriptCapitalH] + Re\[ScriptCapitalH]) (\[ImaginaryI] Im\[ScriptCapitalH] + \
Re\[ScriptCapitalH])]?\
\>", "Section",
 CellChangeTimes->{{3.973334220337508*^9, 
  3.973334248312662*^9}},ExpressionUUID->"6aa7b214-11e8-492d-955d-\
f7b9327db13e"],

Cell[CellGroupData[{

Cell["(#X.1.1): Obtain the Expression:", "Subsection",
 CellChangeTimes->{{3.97333425331986*^9, 
  3.973334266843292*^9}},ExpressionUUID->"f8e0a798-714b-4127-99e1-\
df337d201a57"],

Cell[BoxData[
 RowBox[{"NotSimplifiedRealPart", "=", 
  RowBox[{"Re", "[", 
   RowBox[{"4.403442433793938", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "Im\[ScriptCapitalH]"}], "+", 
      "Re\[ScriptCapitalH]"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "Im\[ScriptCapitalH]"}], "+", 
      "Re\[ScriptCapitalH]"}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.973334056592478*^9, 3.973334073900894*^9}, {
  3.973334313381317*^9, 3.973334335277532*^9}},
 CellLabel->
  "In[131]:=",ExpressionUUID->"bd99ec40-e155-4373-be04-6a9b32f4da14"]
}, Closed]],

Cell[CellGroupData[{

Cell["(#X.1.2): Try to FullSimplify:", "Subsection",
 CellChangeTimes->{{3.9733343410338078`*^9, 
  3.973334353305546*^9}},ExpressionUUID->"80a5f28b-cfc9-4073-8aee-\
ed471f78208b"],

Cell[BoxData[
