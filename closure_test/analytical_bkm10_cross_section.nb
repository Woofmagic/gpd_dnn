       "\[IndentingNewLine]", "curlyCI", ",", "curlyCIV", ",", "curlyCIA", 
       ",", "curlyCIeff", ",", "curlyCIVeff", ",", "curlyCIAeff", ",", 
       "\[IndentingNewLine]", "curlyCILP", ",", "curlyCIVLP", ",", 
       "curlyCIALP", ",", "curlyCIeffLP", ",", "curlyCIVeffLP", ",", 
