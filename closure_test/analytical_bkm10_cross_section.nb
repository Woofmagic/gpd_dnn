              ")"}], 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"2", " ", "K", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"(", 
                  RowBox[{"\[Pi]", "-", "\[Phi]"}], ")"}], "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"t", "/", "qSq"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"xB", 
                   RowBox[{"(", 
                    RowBox[{"2", "-", "y"}], ")"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"y", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "/", "2"}]}], 
                 ")"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"y", " ", 
                  SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "/", "2"}]}], 
              ")"}]}], ")"}]}]}], ")"}], "/", "qSq"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"P2", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "qSq"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"2", "y", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", 
                   SuperscriptBox["\[Epsilon]", "2"]}], ")"}]}], ")"}]}], 
              ")"}], 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"2", " ", "K", " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"(", 
                  RowBox[{"\[Pi]", "-", "\[Phi]"}], ")"}], "]"}]}], "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"t", "/", "qSq"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"xB", 
                   RowBox[{"(", 
                    RowBox[{"2", "-", "y"}], ")"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"y", " ", 
                    SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "/", "2"}]}], 
                 ")"}]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"y", " ", 
                  SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "/", "2"}]}], 
              ")"}]}], ")"}]}], "+", "t"}], ")"}], "/", "qSq"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", "\[IndentingNewLine]", 
       RowBox[{"===", " ", 
        RowBox[{"BETHE", " ", "HEITLER", " ", "CONTRIBUTIONS"}], " ", "==="}],
        "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"c0BH", "=", 
       RowBox[{
        RowBox[{"8", " ", 
         SuperscriptBox["K", "2"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "+", 
              RowBox[{"3", 
               SuperscriptBox["\[Epsilon]", "2"]}]}], ")"}], 
            FractionBox["qSq", "t"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["F1", "2"], "-", 
              RowBox[{
               FractionBox["t", 
                RowBox[{"4", 
                 SuperscriptBox["mp", "2"]}]], 
               SuperscriptBox["F2", "2"]}]}], ")"}]}], "+", 
