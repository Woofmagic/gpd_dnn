       "CVPP2LP", ",", "CAPP2LP", ",", "CPP3LP", ",", "CVPP3LP", ",", 
       "CAPP3LP", ",", "\[IndentingNewLine]", "C0P0LP", ",", "CV0P0LP", ",", 
       "CA0P0LP", ",", "C0P1LP", ",", "CV0P1LP", ",", "CA0P1LP", ",", 
       "C0P2LP", ",", "CV0P2LP", ",", "CA0P2LP", ",", "\[IndentingNewLine]", 
