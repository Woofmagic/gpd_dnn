        "CAPP0", ",", "CPP1", ",", "CVPP1", ",", "CAPP1", ",", "CPP2", ",", 
       "CVPP2", ",", "CAPP2", ",", "CPP3", ",", "CVPP3", ",", "CAPP3", ",", 
       "\[IndentingNewLine]", "C0P0", ",", "CV0P0", ",", "CA0P0", ",", "C0P1",
        ",", "CV0P1", ",", "CA0P1", ",", "C0P2", ",", "CV0P2", ",", "CA0P2", 
