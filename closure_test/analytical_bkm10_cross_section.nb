Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BKM10CrossSection", " ", "[", 
    RowBox[{
    "WW_", ",", "\[Lambda]_", ",", "\[CapitalLambda]_", ",", "k_", ",", 
     "qSq_", ",", "xB_", ",", "t_", ",", "\[Phi]_", ",", 
     "Re\[ScriptCapitalH]_", ",", "Im\[ScriptCapitalH]_", ",", 
     "Re\[ScriptCapitalH]T_", ",", "Im\[ScriptCapitalH]T_", ",", 
     "Re\[ScriptCapitalE]_", ",", "Im\[ScriptCapitalE]_", ",", 
     "Re\[ScriptCapitalE]T_", ",", "Im\[ScriptCapitalE]T_", ",", 
     RowBox[{"Verbose_", ":", "False"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "\[Epsilon]", ",", "y", ",", "\[Xi]", ",", "tMin", ",", "tP", ",", "K", 
       ",", "kT", ",", "FE", ",", "FG", ",", "F1", ",", "F2", ",", "P1", ",", 
       "P2", ",", "\[IndentingNewLine]", "c0BH", ",", "c1BH", ",", "c2BH", 
       ",", "s1BH", ",", "\[IndentingNewLine]", "c0BHLP", ",", "c1BHLP", ",", 
