       ",", "s3ILP", ",", "\[IndentingNewLine]", "BHAmp", ",", "DVCSAmp", ",",
        "IAmp"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Epsilon]", "=", 
       RowBox[{"2", "xB", 
        RowBox[{"(", 
         RowBox[{"mp", "/", 
          RowBox[{"(", 
           RowBox[{"\[Sqrt]", "qSq"}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Epsilon]=\>\"", ",", "\[Epsilon]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       FractionBox[
        SqrtBox["qSq"], 
        RowBox[{"\[Epsilon]", " ", "k"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<y=\>\"", ",", "y"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Xi]", "=", 
       RowBox[{"xB", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"t", "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", "qSq"}], ")"}]}]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "-", "xB", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"xB", " ", "t"}], ")"}], "/", "qSq"}]}], ")"}]}], 
         ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\[Xi]=\>\"", ",", "\[Xi]"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tMin", "=", 
       RowBox[{
        RowBox[{"-", "qSq"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"1", "-", "xB"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", 
               RowBox[{"\[Sqrt]", 
                RowBox[{"(", 
                 RowBox[{"1", " ", "+", " ", 
                  SuperscriptBox["\[Epsilon]", "2"]}], ")"}]}]}], ")"}]}], 
            " ", "+", " ", 
            SuperscriptBox["\[Epsilon]", "2"]}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", " ", "xB", " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "xB"}], ")"}]}], "+", " ", 
            SuperscriptBox["\[Epsilon]", "2"]}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[\(t\), \(min\)]\)=\>\"", ",", "tMin"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tP", "=", 
       RowBox[{"t", "-", "tMin"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<t'=\>\"", ",", "tP"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kT", "=", 
       RowBox[{
        RowBox[{"\[Sqrt]", 
         RowBox[{"(", 
          RowBox[{"tMin", "-", "t"}], ")"}]}], 
        RowBox[{"\[Sqrt]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "xB"}], ")"}], 
            RowBox[{"\[Sqrt]", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               SuperscriptBox["\[Epsilon]", "2"]}], ")"}]}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"tMin", "-", "t"}], ")"}], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["\[Epsilon]", "2"], "+", 
                RowBox[{"4", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "xB"}], ")"}], "xB"}]}], ")"}]}], ")"}], 
            "/", 
            RowBox[{"(", 
             RowBox[{"4", "qSq"}], ")"}]}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Ktilde=\>\"", ",", "kT"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"K", "=", 
       RowBox[{"kT", 
        RowBox[{"\[Sqrt]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "y", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["\[Epsilon]", "2"], 
                SuperscriptBox["y", "2"]}], ")"}], "/", "4"}]}], ")"}], "/", 
           "qSq"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<K=\>\"", ",", "K"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FE", "=", 
       RowBox[{"1", "/", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"t", "/", "FEC"}]}], ")"}], "2"]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(F\), \(E\)]\)=\>\"", ",", "FE"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"FG", "=", 
       RowBox[{"\[Mu]p", " ", "FE"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(F\), \(G\)]\)=\>\"", ",", "FG"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"F2", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"FG", "-", "FE"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "t"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"4", " ", 
             SuperscriptBox["mp", "2"]}], ")"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(F\), \(2\)]\)=\>\"", ",", "F2"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"F1", "=", 
       RowBox[{"FG", "-", "F2"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"Verbose", ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(F\), \(1\)]\)=\>\"", ",", "F1"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"P1", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"qSq", "+", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "qSq"}], ")"}], "/", 
