                SuperscriptBox["t", "2"], 
                SuperscriptBox["qSq", "2"]]}]}], ")"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"F1", "+", "F2"}], ")"}], "2"]}]}], ")"}]}], "+", 
        RowBox[{"8", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SuperscriptBox["\[Epsilon]", "2"]}], ")"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "y", "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["\[Epsilon]", "2"], 
