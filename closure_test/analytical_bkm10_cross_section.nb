Cell[TextData[{
 "Make sure you know what this does! This basic function/module computes the \
effective CFF ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["\[ScriptCapitalF]", "eff"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d1fb079f-f1b2-4d4f-b357-407abc7ffa2b"],
 ". To do so, it needs to know if the WW relations are ",
 StyleBox["on or off!",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.9737789651844378`*^9, 
  3.973779032755953*^9}},ExpressionUUID->"8f01395d-1a25-451e-9780-\
b5cc6f18d2bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"effFF", "[", 
     RowBox[{"UseWW_", ",", "\[Xi]_", ",", "\[ScriptCapitalF]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", " ", 
      RowBox[{"If", "[", 
       RowBox[{"UseWW", ",", 
        FractionBox[
         RowBox[{"2", " ", "\[ScriptCapitalF]"}], 
         RowBox[{"1", "+", "\[Xi]"}]], ",", 
        RowBox[{
         RowBox[{"-", "2"}], "\[Xi]", " ", "\[ScriptCapitalF]", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Xi]"}], ")"}]}], ")"}]}]}], "]"}]}], "]"}]}],
    ";"}], " "}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.972662781272501*^9, 3.972662786010713*^9}, 
   3.9735125056849327`*^9, 3.9735125506753902`*^9},
 CellLabel->"In[48]:=",ExpressionUUID->"a49d7557-a435-49aa-8cd9-9185e53384ee"]
}, Open  ]],

