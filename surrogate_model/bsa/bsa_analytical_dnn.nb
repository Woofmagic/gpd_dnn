Cell[CellGroupData[{

Cell["(#0.1): Glorot Uniform Distribution:", "Section",
 CellChangeTimes->{{3.9900932085626917`*^9, 3.990093216210346*^9}, {
  3.990094630774269*^9, 
  3.9900946426428747`*^9}},ExpressionUUID->"48f8ab27-86bb-4754-9b1a-\
46b31ced98cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"glorotNormalMatrix", "[", 
   RowBox[{"previousLayerDimension_", ",", "finalLayerDimension_"}], "]"}], ":=",
   "\[IndentingNewLine]", 
  RowBox[{"RandomVariate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NormalDistribution", "[", 
     RowBox[{"0", ",", 
      SqrtBox[
       FractionBox["2", 
        RowBox[{
        "previousLayerDimension", " ", "+", " ", "finalLayerDimension"}]]]}], 
     "]"}], ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "zero", " ", "mean", " ", "and", " ", "some", " ", "specific", " ", 
      RowBox[{"spread", "--"}], "look", " ", "online", " ", "for", " ", 
      "\"\<Xavier Normal\>\""}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"finalLayerDimension", ",", "previousLayerDimension"}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.990094748425466*^9, 3.9900948062043877`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"6ec41f3f-c482-4112-bc76-23fb5729746d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"glorotNormalMatrix", "[", 
   RowBox[{"2", ",", "4"}], "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.990094810319853*^9, 3.990094819184208*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"3fa9a20d-b3dd-4d23-b10c-c83a4bcb3aae"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1): Analytical DNN Model:", "Chapter",
 CellChangeTimes->{{3.9900912890558357`*^9, 3.990091298068054*^9}, 
   3.990091331613093*^9},ExpressionUUID->"1dea27fa-5372-4d1f-8cb5-\
18a715fdb301"],

Cell[CellGroupData[{

Cell["(#1.1): Definition of the analytical model:", "Section",
 CellChangeTimes->{{3.990091324961059*^9, 3.990091336846183*^9}, {
  3.990092477035265*^9, 
  3.990092478758068*^9}},ExpressionUUID->"400620c8-2efe-4eae-b53e-\
cd10bc912945"],

Cell[TextData[{
 "Recall that the features are t, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "B"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1d58214b-2f9c-4a5f-b298-d3eaf1faba06"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "27ddd8b8-c061-497e-b9fd-e92d9a8e0517"],
 ", and \[Phi] and the single label is the BSA(\[CapitalLambda]=0):\n1. \
Activation functions are tanh\n2. Hidden layers are initialized by \
GlorotUniform"
}], "Text",
 CellChangeTimes->{{3.990091344133676*^9, 3.9900913693856*^9}, {
  3.99009143851153*^9, 3.9900914515540657`*^9}, {3.9900948414709*^9, 
  3.99009485009022*^9}},ExpressionUUID->"f1565a52-b2c1-49a7-8065-\
8c998a340ce9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"BSASurrogateDNNModel", "[", 
    RowBox[{"t_", ",", "xb_", ",", "qsq_", ",", "\[Phi]_"}], "]"}], "=", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"glorotNormalMatrix", "[", 
     RowBox[{"16", ",", "1"}], "]"}], ".", "\[IndentingNewLine]", 
    RowBox[{"Tanh", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"preactivations", " ", "layer", " ", "3"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"glorotNormalMatrix", "[", 
       RowBox[{"16", ",", "16"}], "]"}], ".", "\[IndentingNewLine]", 
      RowBox[{"Tanh", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"preactivations", " ", "layer", " ", "2"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"glorotNormalMatrix", "[", 
         RowBox[{"16", ",", "16"}], "]"}], ".", "\[IndentingNewLine]", 
        RowBox[{"Tanh", "[", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"preactivaitons", " ", "layer", " ", "1"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"glorotNormalMatrix", "[", 
           RowBox[{"4", ",", "16"}], "]"}], ".", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"feature", " ", "vector"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"t", ",", "xb", ",", "qsq", ",", "\[Phi]"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.989338010512157*^9, 3.989338175099409*^9}, {
   3.990091456272977*^9, 3.990091466917433*^9}, {3.990091549064659*^9, 
   3.990091552300967*^9}, {3.990092496859934*^9, 3.990092507517992*^9}, {
   3.990092564430209*^9, 3.9900926005386467`*^9}, {3.990092634877304*^9, 
   3.990092692886291*^9}, {3.990093229147305*^9, 3.990093230677026*^9}, {
   3.9900948587251596`*^9, 3.990094884201563*^9}, 3.990094919850399*^9, {
   3.990527715232418*^9, 3.990527717981299*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"8a22c379-57bc-481a-b816-dfbd420845b2"]
}, Open  ]],

