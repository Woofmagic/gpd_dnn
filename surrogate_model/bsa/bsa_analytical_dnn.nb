Cell[CellGroupData[{

Cell[TextData[{
 "(#4.1.1): Making DNN Predictions at ",
 StyleBox["Fixed Kinematics present in the original dataset ",
  FontSlant->"Italic"],
 "vs. \[Phi]:"
}], "Subsection",
 CellChangeTimes->{{3.990520468512639*^9, 3.990520487747954*^9}, {
   3.990520993618162*^9, 3.990521003474428*^9}, 3.990527840220086*^9, {
   3.9905279573028*^9, 
   3.990527958787241*^9}},ExpressionUUID->"1cbd1444-7f94-45d9-83aa-\
8f84c22090f0"],

Cell["\<\
Make sure you understand the syntax below, particularly why we can use the \
index [[1]]:\
\>", "Text",
 CellChangeTimes->{{3.990521007892437*^9, 
  3.9905210494015207`*^9}},ExpressionUUID->"753ca223-f781-4a28-a1f7-\
b474644da0a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"localFitBin1FixedT", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "1"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<t\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"localFitBin1FixedXBjorken", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "1"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<x_b\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"localFitBin1FixedQSquared", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "1"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<q_squared\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.990520463023402*^9, 3.9905205823681583`*^9}, {
  3.990520753994356*^9, 3.990520763940229*^9}, {3.9905210290340137`*^9, 
  3.990521068158916*^9}, {3.990521385578883*^9, 3.99052139844135*^9}, {
  3.990521643974074*^9, 3.990521644063154*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"0c5faa43-cf6d-4e1b-8bb7-b2540bb12a6a"],

Cell["\<\
The cell below is also quite complicated; it took me a while to figure out \
what is going on, but it works. The idea is, to plot the actual datapoints, \
we need to make a list of lists: a list of the \[OpenCurlyDoubleQuote]tuples\
\[CloseCurlyDoubleQuote] of the \[Phi] and BSA. So, we did that using a \
series of sub-dataset constructions and datatype manipulations:\
\>", "Text",
 CellChangeTimes->{{3.990521878061673*^9, 
  3.990521930290288*^9}},ExpressionUUID->"9d77c1eb-a277-4960-b817-\
d9e412f0e2ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"localFitBin1PhiAndBSA", "=", 
   RowBox[{"Values", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"dataset", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "1"}], "&"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"\"\<phi\>\"", ",", "\"\<unp_target_bsa\>\""}], "}"}]}], 
      "]"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.990521932797367*^9, 3.9905219356898403`*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"3a4889f3-91a1-420d-a237-479374c6b263"],

Cell["\<\
[NOTE]: What is the output of the DNN? Is it a scalar, or a list with one \
scalar?\
\>", "Text",
 CellChangeTimes->{{3.990520585544965*^9, 
  3.990520606582602*^9}},ExpressionUUID->"ce911766-ba63-49ca-a470-\
2a87668f2baa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#4.1.2): Show the corresponding local fit plot:", "Subsection",
 CellChangeTimes->{{3.990527961366272*^9, 3.990527965718102*^9}, {
  3.990528000586341*^9, 
  3.990528004202856*^9}},ExpressionUUID->"09d33304-9441-4e13-a02b-\
455ddc4f497b"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"First", "[", 
      RowBox[{"trainedModel", "[", 
       RowBox[{"{", 
        RowBox[{
        "localFitBin1FixedT", ",", "localFitBin1FixedXBjorken", ",", 
         "localFitBin1FixedQSquared", ",", "phi"}], "}"}], "]"}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"phi", ",", 
       RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", "Blue"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", "\"\<DNN Predictions\>\"", "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
    RowBox[{"localFitBin1PhiAndBSA", ",", "\[IndentingNewLine]", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", "Medium", "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", "\"\<Experimental Data (Set 1)\>\"", "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[Phi] (radians\>\"", ",", " ", 
      "\"\<BSA(\[CapitalLambda] = 0)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"StringForm", "[", 
     RowBox[{
     "\"\<Surrogate DNN Local Fit at t=`1`, xb=`2`, Q\.b2=`3`\>\"", ",", 
      "localFitBin1FixedT", ",", "localFitBin1FixedXBjorken", ",", 
      "localFitBin1FixedQSquared"}], "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.9905219631965218`*^9, 3.990522037395871*^9}, {
  3.990522101489649*^9, 3.990522133388214*^9}, {3.990522258572728*^9, 
  3.9905222822293177`*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"ad31773a-0d92-4e1d-b67a-0e210514033c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "(#4.2): Making several plots of ",
