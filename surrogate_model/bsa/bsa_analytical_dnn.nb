Cell[CellGroupData[{

Cell["(#2.2.2): Actually generating the Dataset:", "Subsection",
 CellChangeTimes->{{3.990519189465386*^9, 
  3.990519195106028*^9}},ExpressionUUID->"4df6f6c0-7072-45ed-8313-\
0797ca3eae1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"features", "=", 
   RowBox[{"Values", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"dataset", "[", 
      RowBox[{"All", ",", "featureColumns"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"labels", "=", 
    RowBox[{"List", "/@", 
     RowBox[{"Normal", "[", 
      RowBox[{"dataset", "[", 
       RowBox[{"All", ",", "labelColumn"}], "]"}], "]"}]}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "this", " ", "is", " ", "a", " ", "Mathematica", " ", 
    "\"\<association\>\"", " ", 
    RowBox[{"structure", ":"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"labeledData", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<Input\>\"", "->", "features"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"\"\<Output\>\"", "->", "labels"}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",
