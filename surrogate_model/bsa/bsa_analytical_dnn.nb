Cell[CellGroupData[{

Cell[TextData[{
 "(#4.2.1): Grouping the Dataset by unique kinematic settings, (t, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "B"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ff6eee8-f8b6-452d-92e0-2c88e94145e9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f0d5f956-091d-4d35-9c17-8cb227971fc0"],
 "):"
}], "Subsection",
 CellChangeTimes->{{3.99052802483364*^9, 
  3.9905280423043528`*^9}},ExpressionUUID->"34f3ccec-fafd-4786-92f3-\
e81903661116"],

Cell[BoxData[
 RowBox[{
  RowBox[{"groupedKinematicSettingsDataset", "=", 
   RowBox[{
    RowBox[{"Values", "[", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"dataset", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", "\"\<t\>\"", "]"}], ",", 
          RowBox[{"#", "[", "\"\<x_b\>\"", "]"}], ",", 
          RowBox[{"#", "[", "\"\<q_squared\>\"", "]"}]}], "}"}], "&"}]}], 
      "]"}], "]"}], "//", "Normal"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.990525180595936*^9, 3.990525185648437*^9}, 
   3.990525343185302*^9, {3.990525384689958*^9, 3.990525403816702*^9}, 
   3.9905255402225943`*^9, {3.9905259121617928`*^9, 3.990525919651469*^9}, {
   3.990528045895155*^9, 3.990528052680808*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"5a476f5d-59fe-4d54-87ac-aaa567636823"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(#4.2.2): A huge module that basically runs the local fitting plot logic we \
already coded above:\
\>", "Subsection",
 CellChangeTimes->{{3.990528055555684*^9, 
  3.99052807387799*^9}},ExpressionUUID->"f1aca596-3361-409c-ac41-\
9dcdd72f9707"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeKinematicPlot", "[", "subGroup_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "firstRow", ",", "fixedT", ",", "fixedXb", ",", "fixedQ2", ",", 
       "phiAndBsa"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"firstRow", "=", 
       RowBox[{"subGroup", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fixedT", "=", 
       RowBox[{"firstRow", "[", "\"\<t\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fixedXb", "=", 
       RowBox[{"firstRow", "[", "\"\<x_b\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fixedQ2", "=", 
       RowBox[{"firstRow", "[", "\"\<q_squared\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"phiAndBsa", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"subGroup", ",", 
         RowBox[{"{", 
