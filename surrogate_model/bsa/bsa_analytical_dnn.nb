Cell[CellGroupData[{

Cell["(#3.2): DNN Training Happens Here!", "Section",
 CellChangeTimes->{{3.990520110078167*^9, 3.990520123515147*^9}, 
   3.990526063658519*^9},ExpressionUUID->"836ff6ee-5ddd-47e6-b817-\
ce915dfb1f51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/", "q"}], 
      "/", "164470"}], " ", "->", " ", 
     RowBox[{"for", " ", "ADAM", " ", "optimizer", " ", "parameters"}]}]}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"trainedModel", "=", 
    RowBox[{"NetTrain", "[", "\[IndentingNewLine]", 
     RowBox[{
     "initializedBSASurrogateModel", ",", "\[IndentingNewLine]", 
      "labeledData", ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "this", " ", "randomly", " ", "samples", " ", "20", "%", " ", "of", 
         " ", "the", " ", "training", " ", 
         RowBox[{"data", "--"}]}], "-", 
        RowBox[{
        "it", " ", "is", " ", "smart", " ", "enough", " ", "to", " ", "know", 
         " ", "how", " ", "to", " ", "do", " ", "that"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ValidationSet", "->", 
       RowBox[{"Scaled", "[", "0.2", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Method", "->", 
       RowBox[{
       "{", "\[IndentingNewLine]", "\"\<ADAM\>\"", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"LearningRate", "->", "0.001"}], ","}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"\"\<Beta1\>\"", "->", "0.9"}], ","}], " ", 
         RowBox[{"(*", " ", 
          RowBox[{"default", " ", 
           RowBox[{"setting", "!"}]}], " ", "*)"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"\"\<Beta2\>\"", "->", "0.999"}], ","}], " ", 
         RowBox[{"(*", " ", 
          RowBox[{"default", " ", 
           RowBox[{"setting", "!"}]}], " ", "*)"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"\"\<Epsilon\>\"", "->", " ", 
          RowBox[{"Rational", "[", 
           RowBox[{"1", ",", "100000"}], "]"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"MaxTrainingRounds", "->", "1500"}], ",", "\[IndentingNewLine]", 
      RowBox[{"BatchSize", "->", "8"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.990518994660041*^9, 3.990519020829529*^9}, {
   3.990519662470245*^9, 3.99051969316938*^9}, {3.990519731544001*^9, 
   3.990519756271186*^9}, {3.990519807688281*^9, 3.990519807801421*^9}, {
   3.990519898219727*^9, 3.990519942895225*^9}, {3.990519977784728*^9, 
   3.990519988315971*^9}, {3.990524503264698*^9, 3.990524533398405*^9}, {
   3.990524792000325*^9, 3.9905248172454348`*^9}, 3.990526089494376*^9, 
   3.990526206795479*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"a2eb4ffe-9345-4844-9162-8f0c0849d287"]
}, Open  ]],

