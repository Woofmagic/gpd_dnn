  RowBox[{"NetChain", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"LinearLayer", "[", "64", "]"}], ",", "Ramp", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "32", "]"}], ",", "Ramp", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "16", "]"}], ",", "Ramp", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"LinearLayer", "[", "1", "]"}]}], "\[IndentingNewLine]", "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Input\>\"", "->", "4"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<Output\>\"", "->", "1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9905189609802723`*^9, 3.990518983039105*^9}, 
   3.990519217840178*^9, 3.990526087698555*^9, {3.9905261893225613`*^9, 
