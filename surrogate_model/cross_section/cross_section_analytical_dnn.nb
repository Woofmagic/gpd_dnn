Cell[CellGroupData[{

Cell[TextData[{
 "(#4.1.1): Making DNN Predictions at ",
 StyleBox["Fixed Kinematics present in the original dataset ",
  FontSlant->"Italic"],
 "vs. \[Phi]:"
}], "Subsection",
 CellChangeTimes->{{3.990520468512639*^9, 3.990520487747954*^9}, {
   3.990520993618162*^9, 3.990521003474428*^9}, 3.990527840220086*^9, {
   3.9905279573028*^9, 
   3.990527958787241*^9}},ExpressionUUID->"1cbd1444-7f94-45d9-83aa-\
8f84c22090f0"],

Cell["\<\
Make sure you understand the syntax below, particularly why we can use the \
index [[1]]. (Also understand why we can use the magic number 324\
\>", "Text",
 CellChangeTimes->{{3.990521007892437*^9, 3.9905210494015207`*^9}, {
  3.990537913230324*^9, 
  3.9905379270497093`*^9}},ExpressionUUID->"753ca223-f781-4a28-a1f7-\
b474644da0a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"localFitBin1FixedK", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "324"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<k\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"localFitBin1FixedT", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "324"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<t\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"localFitBin1FixedXBjorken", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "324"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<x_b\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"localFitBin1FixedQSquared", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"dataset", "[", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "324"}], "&"}], "]"}], 
      "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<q_squared\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.990520463023402*^9, 3.9905205823681583`*^9}, {
  3.990520753994356*^9, 3.990520763940229*^9}, {3.9905210290340137`*^9, 
  3.990521068158916*^9}, {3.990521385578883*^9, 3.99052139844135*^9}, {
  3.990521643974074*^9, 3.990521644063154*^9}, {3.990537908686165*^9, 
  3.9905379109058533`*^9}, {3.990629914291255*^9, 3.990629920060281*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"0c5faa43-cf6d-4e1b-8bb7-b2540bb12a6a"],

Cell["\<\
The cell below is also quite complicated; it took me a while to figure out \
what is going on, but it works. The idea is, to plot the actual datapoints, \
we need to make a list of lists: a list of the \[OpenCurlyDoubleQuote]tuples\
\[CloseCurlyDoubleQuote] of the \[Phi] and BSA. So, we did that using a \
series of sub-dataset constructions and datatype manipulations:\
\>", "Text",
 CellChangeTimes->{{3.990521878061673*^9, 
  3.990521930290288*^9}},ExpressionUUID->"9d77c1eb-a277-4960-b817-\
d9e412f0e2ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"localFitBin1PhiAndCrossSection", "=", 
   RowBox[{"Values", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"dataset", "[", 
      RowBox[{
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<set\>\"", "]"}], "==", "324"}], "&"}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"\"\<phi\>\"", ",", "\"\<unp_beam_unp_target_xsec\>\""}], 
        "}"}]}], "]"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.990521932797367*^9, 3.9905219356898403`*^9}, {
   3.990537912057337*^9, 3.990537931916905*^9}, {3.990538215168067*^9, 
   3.990538218083109*^9}, 3.990632266603765*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"3a4889f3-91a1-420d-a237-479374c6b263"]
}, Open  ]],

