Cell[CellGroupData[{

Cell["(#3.2): DNN Training Happens Here!", "Section",
 CellChangeTimes->{{3.990520110078167*^9, 3.990520123515147*^9}, 
   3.990526063658519*^9},ExpressionUUID->"836ff6ee-5ddd-47e6-b817-\
ce915dfb1f51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"https", ":"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/", "q"}], 
      "/", "164470"}], " ", "->", " ", 
     RowBox[{"for", " ", "ADAM", " ", "optimizer", " ", "parameters"}]}]}], 
   " ", "*)"}], "\[IndentingNewLine]", "\t", 
  RowBox[{"trainedModel", "=", 
   RowBox[{"NetTrain", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
    "initializedCrossSectionSurrogateModel", ",", "\[IndentingNewLine]", "\t",
      "labeledData", ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "this", " ", "randomly", " ", "samples", " ", "20", "%", " ", "of", 
        " ", "the", " ", "training", " ", 
        RowBox[{"data", "--"}]}], "-", 
       RowBox[{
       "it", " ", "is", " ", "smart", " ", "enough", " ", "to", " ", "know", 
        " ", "how", " ", "to", " ", "do", " ", "that"}]}], "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"ValidationSet", "->", 
      RowBox[{"Scaled", "[", "0.2", "]"}]}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"Method", "->", 
      RowBox[{
      "{", "\[IndentingNewLine]", "\t", "\"\<ADAM\>\"", "\[IndentingNewLine]",
        "\t", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"LearningRate", "->", "0.001"}], ","}], " ", "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"\"\<Beta1\>\"", "->", "0.9"}], ","}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{"default", " ", 
          RowBox[{"setting", "!"}]}], " ", "*)"}], " ", "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"\"\<Beta2\>\"", "->", "0.999"}], ","}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{"default", " ", 
          RowBox[{"setting", "!"}]}], " ", "*)"}], " ", "*)"}], 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"(*", " ", 
        RowBox[{"\"\<Epsilon\>\"", "->", " ", 
         RowBox[{"Rational", "[", 
          RowBox[{"1", ",", "100000"}], "]"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", "\t", "}"}]}], ",", "\[IndentingNewLine]", "\t", 
     RowBox[{"MaxTrainingRounds", "->", "1500"}], ",", "\[IndentingNewLine]", 
     "\t", 
     RowBox[{"BatchSize", "->", "8"}]}], "\[IndentingNewLine]", "\t", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.990518994660041*^9, 3.990519020829529*^9}, {
