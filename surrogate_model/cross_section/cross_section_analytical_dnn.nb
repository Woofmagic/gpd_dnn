Cell[BoxData[
 RowBox[{
  RowBox[{"groupedKinematicSettingsDataset", "=", 
   RowBox[{
    RowBox[{"Values", "[", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"dataset", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", "\"\<k\>\"", "]"}], ",", 
          RowBox[{"#", "[", "\"\<t\>\"", "]"}], ",", 
          RowBox[{"#", "[", "\"\<x_b\>\"", "]"}], ",", 
          RowBox[{"#", "[", "\"\<q_squared\>\"", "]"}]}], "}"}], "&"}]}], 
      "]"}], "]"}], "//", "Normal"}]}], ";"}]], "Input",
