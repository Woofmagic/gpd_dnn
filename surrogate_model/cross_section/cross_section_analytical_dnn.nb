8c998a340ce9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CrossSectionSurrogateDNNModel", "[", 
    RowBox[{"k_", ",", "t_", ",", "xb_", ",", "qsq_", ",", "\[Phi]_"}], "]"}],
    "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"glorotNormalMatrix", "[", 
     RowBox[{"16", ",", "1"}], "]"}], ".", "\[IndentingNewLine]", 
    RowBox[{"LogisticSigmoid", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"preactivations", " ", "layer", " ", "3"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"glorotNormalMatrix", "[", 
       RowBox[{"16", ",", "16"}], "]"}], ".", "\[IndentingNewLine]", 
      RowBox[{"LogisticSigmoid", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"preactivations", " ", "layer", " ", "2"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"glorotNormalMatrix", "[", 
         RowBox[{"16", ",", "16"}], "]"}], ".", "\[IndentingNewLine]", 
        RowBox[{"LogisticSigmoid", "[", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"preactivaitons", " ", "layer", " ", "1"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"glorotNormalMatrix", "[", 
           RowBox[{"5", ",", "16"}], "]"}], ".", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{"feature", " ", "vector"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "t", ",", "xb", ",", "qsq", ",", "\[Phi]"}],
            "}"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
       "]"}]}], "\[IndentingNewLine]", "]"}]}]}], ";"}]], "Input",
