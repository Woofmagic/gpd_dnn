  FormBox[
   RowBox[{
    SuperscriptBox["d", "4"], 
    SuperscriptBox["\[Sigma]", "UU"]}], TraditionalForm]],ExpressionUUID->
  "a447da48-4394-4ef6-8f15-6f8cb58b1e9b"],
 ":\n1. Activation functions are Silu... but we haven\[CloseCurlyQuote]t \
implemented them yet:\n2. Hidden layers are initialized by GlorotUniform"
}], "Text",
 CellChangeTimes->{{3.990091344133676*^9, 3.9900913693856*^9}, {
  3.99009143851153*^9, 3.9900914515540657`*^9}, {3.9900948414709*^9, 
