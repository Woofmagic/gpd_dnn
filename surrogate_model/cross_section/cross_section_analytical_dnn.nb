Cell[CellGroupData[{

Cell["\<\
(#4.2.2): A huge module that basically runs the local fitting plot logic we \
already coded above:\
\>", "Subsection",
 CellChangeTimes->{{3.990528055555684*^9, 
  3.99052807387799*^9}},ExpressionUUID->"f1aca596-3361-409c-ac41-\
9dcdd72f9707"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"makeKinematicPlot", "[", "subGroup_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "firstRow", ",", "fixedK", ",", " ", "fixedT", ",", "fixedXb", ",", 
       "fixedQ2", ",", "phiAndBsa"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"firstRow", "=", 
       RowBox[{"subGroup", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fixedK", "=", 
       RowBox[{"firstRow", "[", "\"\<k\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fixedT", "=", 
       RowBox[{"firstRow", "[", "\"\<t\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fixedXb", "=", 
       RowBox[{"firstRow", "[", "\"\<x_b\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"fixedQ2", "=", 
       RowBox[{"firstRow", "[", "\"\<q_squared\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"phiAndBsa", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"subGroup", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<phi\>\"", ",", "\"\<unp_beam_unp_target_xsec\>\""}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Show", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Plot", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"trainedModel", "[", 
            RowBox[{"{", 
             RowBox[{
             "fixedK", ",", "fixedT", ",", "fixedXb", ",", "fixedQ2", ",", 
              "phi"}], "}"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"phi", ",", 
            RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Thick", ",", "Blue"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"{", "\"\<DNN Predictions\>\"", "}"}]}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
         RowBox[{"phiAndBsa", ",", "\[IndentingNewLine]", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Red", ",", 
             RowBox[{"PointSize", "[", "Medium", "]"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"{", "\"\<Experimental Data\>\"", "}"}]}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\[Phi] (radians)\>\"", ",", " ", 
           "\"\<\!\(\*SuperscriptBox[\(d\), \(4\)]\)\!\(\*SuperscriptBox[\(\
\[Sigma]\), \(UU\)]\) (nb/\!\(\*SuperscriptBox[\(GeV\), \(-4\)]\)\>\""}], 
          "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"StringForm", "[", 
          RowBox[{
          "\"\<Surrogate DNN Fit at k = `1`, t = `2`, \
\!\(\*SubscriptBox[\(x\), \(B\)]\) = `3`, Q\.b2 = `4`\>\"", ",", 
           "localFitBin1FixedK", ",", " ", "localFitBin1FixedT", ",", 
           "localFitBin1FixedXBjorken", ",", "localFitBin1FixedQSquared"}], 
          "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", "Automatic"}], ",", 
        RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.990525201878953*^9, 3.990525201879878*^9}, {
   3.9905252667793617`*^9, 3.9905252963982973`*^9}, {3.990525448345525*^9, 
   3.990525468982683*^9}, {3.990525530526531*^9, 3.990525531524899*^9}, 
   3.990525641542997*^9, {3.990525848781584*^9, 3.99052592544632*^9}, {
   3.990525991599917*^9, 3.990526001902501*^9}, {3.9905280767362003`*^9, 
   3.9905280885849657`*^9}, {3.990528346247038*^9, 3.99052835336838*^9}, 
   3.990537991197297*^9, {3.990538228120708*^9, 3.990538229041641*^9}, {
   3.9906299745690117`*^9, 3.990630005182291*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"d0995e78-e86d-4863-8efb-b75dc215a1b0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
(#4.2.3): Run the module across all of the bins in the kinematic settings \
dataset:\
\>", "Subsection",
 CellChangeTimes->{{3.990528106568802*^9, 
  3.99052818751156*^9}},ExpressionUUID->"7c19291f-5eb4-4453-b97d-\
a205a7769bbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "below", " ", "is", " ", "essentially", " ", "list", " ", 
     "comprehension"}], ",", " ", 
    RowBox[{
     RowBox[{"i", ".", "e", ".", " ", 
      RowBox[{"that", "'"}]}], "s", " ", "how", " ", "we", " ", "should", " ",
      "read", " ", "it"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"allPlots", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"makeKinematicPlot", "[", "kinematicBin", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"kinematicBin", ",", "groupedKinematicSettingsDataset"}], 
       "}"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.990525206772781*^9, 3.990525206773387*^9}, {
   3.990525246263348*^9, 3.990525247486927*^9}, 3.99052557929976*^9, 
   3.990526303345954*^9, {3.990528078461164*^9, 3.990528082758177*^9}, {
   3.9905281545993958`*^9, 3.990528175932852*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"6edaf722-9d39-4ae0-bbb7-72400a81b2b9"]
}, Open  ]],

